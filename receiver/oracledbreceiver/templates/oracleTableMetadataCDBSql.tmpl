/* otel-collector */
WITH columns_agg AS (
    SELECT c.CON_ID, c.OWNER, c.TABLE_NAME,
        JSON_ARRAYAGG(
            JSON_OBJECT(
                'name' VALUE c.COLUMN_NAME,
                'data_type' VALUE c.DATA_TYPE,
                'data_length' VALUE c.DATA_LENGTH,
                'nullable' VALUE c.NULLABLE,
                'default' VALUE c.DATA_DEFAULT
            ) ORDER BY c.COLUMN_ID
        ) AS COLUMNS_JSON
    FROM CDB_TAB_COLUMNS c
    WHERE c.OWNER NOT IN (SELECT USERNAME FROM CDB_USERS WHERE ORACLE_MAINTAINED = 'Y' AND CON_ID = c.CON_ID)
    GROUP BY c.CON_ID, c.OWNER, c.TABLE_NAME
),
indexes_agg AS (
    SELECT i.CON_ID, i.OWNER, i.TABLE_NAME,
        JSON_ARRAYAGG(
            JSON_OBJECT(
                'name' VALUE idx.INDEX_NAME,
                'index_type' VALUE idx.INDEX_TYPE,
                'uniqueness' VALUE idx.UNIQUENESS,
                'column_names' VALUE idx.COLUMN_NAMES
            )
        ) AS INDEXES_JSON
    FROM (
        SELECT ic.CON_ID, ic.TABLE_OWNER AS OWNER, ic.TABLE_NAME, ic.INDEX_NAME,
            MAX(i2.INDEX_TYPE) AS INDEX_TYPE, MAX(i2.UNIQUENESS) AS UNIQUENESS,
            LISTAGG(ic.COLUMN_NAME, ',') WITHIN GROUP (ORDER BY ic.COLUMN_POSITION) AS COLUMN_NAMES
        FROM CDB_IND_COLUMNS ic
        JOIN CDB_INDEXES i2 ON i2.INDEX_NAME = ic.INDEX_NAME AND i2.OWNER = ic.INDEX_OWNER AND i2.CON_ID = ic.CON_ID
        WHERE ic.TABLE_OWNER NOT IN (SELECT USERNAME FROM CDB_USERS WHERE ORACLE_MAINTAINED = 'Y' AND CON_ID = ic.CON_ID)
        GROUP BY ic.CON_ID, ic.TABLE_OWNER, ic.TABLE_NAME, ic.INDEX_NAME
    ) i
    JOIN CDB_INDEXES idx ON idx.INDEX_NAME = i.INDEX_NAME AND idx.OWNER = i.OWNER AND idx.CON_ID = i.CON_ID
    GROUP BY i.CON_ID, i.OWNER, i.TABLE_NAME
),
foreign_keys_agg AS (
    SELECT fk.CON_ID, fk.OWNER, fk.TABLE_NAME,
        JSON_ARRAYAGG(
            JSON_OBJECT(
                'name' VALUE fk.CONSTRAINT_NAME,
                'column_names' VALUE fk.COLUMN_NAMES,
                'referenced_schema' VALUE fk.R_OWNER,
                'referenced_table_name' VALUE fk.R_TABLE_NAME,
                'referenced_column_names' VALUE fk.R_COLUMN_NAMES,
                'delete_rule' VALUE fk.DELETE_RULE
            )
        ) AS FOREIGN_KEYS_JSON
    FROM (
        SELECT c.CON_ID, c.OWNER, c.TABLE_NAME, c.CONSTRAINT_NAME, c.DELETE_RULE,
            rc.OWNER AS R_OWNER, rc.TABLE_NAME AS R_TABLE_NAME,
            LISTAGG(cc.COLUMN_NAME, ',') WITHIN GROUP (ORDER BY cc.POSITION) AS COLUMN_NAMES,
            LISTAGG(rcc.COLUMN_NAME, ',') WITHIN GROUP (ORDER BY rcc.POSITION) AS R_COLUMN_NAMES
        FROM CDB_CONSTRAINTS c
        JOIN CDB_CONS_COLUMNS cc ON cc.CONSTRAINT_NAME = c.CONSTRAINT_NAME AND cc.OWNER = c.OWNER AND cc.CON_ID = c.CON_ID
        JOIN CDB_CONSTRAINTS rc ON rc.CONSTRAINT_NAME = c.R_CONSTRAINT_NAME AND rc.OWNER = c.R_OWNER AND rc.CON_ID = c.CON_ID
        JOIN CDB_CONS_COLUMNS rcc ON rcc.CONSTRAINT_NAME = rc.CONSTRAINT_NAME AND rcc.OWNER = rc.OWNER AND rcc.CON_ID = rc.CON_ID
            AND rcc.POSITION = cc.POSITION
        WHERE c.OWNER NOT IN (SELECT USERNAME FROM CDB_USERS WHERE ORACLE_MAINTAINED = 'Y' AND CON_ID = c.CON_ID)
          AND c.CONSTRAINT_TYPE = 'R'
        GROUP BY c.CON_ID, c.OWNER, c.TABLE_NAME, c.CONSTRAINT_NAME, c.DELETE_RULE, rc.OWNER, rc.TABLE_NAME
    ) fk
    GROUP BY fk.CON_ID, fk.OWNER, fk.TABLE_NAME
),
size_agg AS (
    SELECT CON_ID, TABLE_NAME, OWNER,
        SUM(CASE WHEN KIND = 'TABLE' THEN BYTES ELSE 0 END) AS TABLE_BYTES,
        SUM(CASE WHEN KIND = 'INDEX' THEN BYTES ELSE 0 END) AS INDEX_BYTES,
        SUM(CASE WHEN KIND = 'LOB' THEN BYTES ELSE 0 END) AS LOB_BYTES,
        SUM(BYTES) AS TOTAL_BYTES
    FROM (
        SELECT s.CON_ID, s.TABLE_NAME, s.OWNER, 'TABLE' AS KIND, seg.BYTES
        FROM CDB_SEGMENTS seg
        JOIN CDB_TABLES s ON s.TABLE_NAME = seg.SEGMENT_NAME AND s.OWNER = seg.OWNER AND s.CON_ID = seg.CON_ID
        WHERE seg.SEGMENT_TYPE IN ('TABLE', 'TABLE PARTITION', 'TABLE SUBPARTITION')
        UNION ALL
        SELECT i.CON_ID, i.TABLE_NAME, i.OWNER, 'INDEX' AS KIND, seg.BYTES
        FROM CDB_SEGMENTS seg
        JOIN CDB_INDEXES i ON i.INDEX_NAME = seg.SEGMENT_NAME AND i.OWNER = seg.OWNER AND i.CON_ID = seg.CON_ID
        WHERE seg.SEGMENT_TYPE IN ('INDEX', 'INDEX PARTITION', 'INDEX SUBPARTITION')
        UNION ALL
        SELECT l.CON_ID, l.TABLE_NAME, l.OWNER, 'LOB' AS KIND, seg.BYTES
        FROM CDB_SEGMENTS seg
        JOIN CDB_LOBS l ON l.SEGMENT_NAME = seg.SEGMENT_NAME AND l.OWNER = seg.OWNER AND l.CON_ID = seg.CON_ID
        WHERE seg.SEGMENT_TYPE IN ('LOBSEGMENT', 'LOB PARTITION')
    )
    GROUP BY CON_ID, TABLE_NAME, OWNER
)
SELECT
    t.OWNER AS SCHEMA_NAME, t.TABLE_NAME,
    NVL(ctr.NAME, '') AS DB_NAMESPACE,
    NVL(t.NUM_ROWS, 0) AS ROW_COUNT,
    COALESCE(ca.COLUMNS_JSON, '[]') AS COLUMNS_JSON,
    COALESCE(ia.INDEXES_JSON, '[]') AS INDEXES_JSON,
    COALESCE(fka.FOREIGN_KEYS_JSON, '[]') AS FOREIGN_KEYS_JSON,
    NVL(sa.TABLE_BYTES, 0) AS TABLE_BYTES,
    NVL(sa.INDEX_BYTES, 0) AS INDEX_BYTES,
    NVL(sa.LOB_BYTES, 0) AS LOB_BYTES,
    NVL(sa.TOTAL_BYTES, 0) AS TOTAL_BYTES
FROM CDB_TABLES t
LEFT JOIN V$CONTAINERS ctr ON ctr.CON_ID = t.CON_ID
LEFT JOIN columns_agg ca ON ca.OWNER = t.OWNER AND ca.TABLE_NAME = t.TABLE_NAME AND ca.CON_ID = t.CON_ID
LEFT JOIN indexes_agg ia ON ia.OWNER = t.OWNER AND ia.TABLE_NAME = t.TABLE_NAME AND ia.CON_ID = t.CON_ID
LEFT JOIN foreign_keys_agg fka ON fka.OWNER = t.OWNER AND fka.TABLE_NAME = t.TABLE_NAME AND fka.CON_ID = t.CON_ID
LEFT JOIN size_agg sa ON sa.OWNER = t.OWNER AND sa.TABLE_NAME = t.TABLE_NAME AND sa.CON_ID = t.CON_ID
WHERE t.OWNER NOT IN (SELECT USERNAME FROM CDB_USERS WHERE ORACLE_MAINTAINED = 'Y' AND CON_ID = t.CON_ID)
  AND t.DROPPED = 'NO'
ORDER BY t.OWNER, t.TABLE_NAME
FETCH FIRST :1 ROWS ONLY
