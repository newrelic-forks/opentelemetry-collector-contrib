/* otel-collector */
WITH columns_agg AS (
    SELECT c.OWNER, c.TABLE_NAME,
        JSON_ARRAYAGG(
            JSON_OBJECT(
                'name' VALUE c.COLUMN_NAME,
                'data_type' VALUE c.DATA_TYPE,
                'data_length' VALUE c.DATA_LENGTH,
                'nullable' VALUE c.NULLABLE
            ) ORDER BY c.COLUMN_ID
        ) AS COLUMNS_JSON
    FROM DBA_TAB_COLUMNS c
    WHERE c.OWNER NOT IN (SELECT USERNAME FROM DBA_USERS WHERE ORACLE_MAINTAINED = 'Y')
    GROUP BY c.OWNER, c.TABLE_NAME
)
SELECT
    v.OWNER AS SCHEMA_NAME, v.VIEW_NAME,
    '' AS DB_NAMESPACE,
    COALESCE(ca.COLUMNS_JSON, '[]') AS COLUMNS_JSON,
    v.TEXT_VC AS DEFINITION
FROM DBA_VIEWS v
LEFT JOIN columns_agg ca ON ca.OWNER = v.OWNER AND ca.TABLE_NAME = v.VIEW_NAME
WHERE v.OWNER NOT IN (SELECT USERNAME FROM DBA_USERS WHERE ORACLE_MAINTAINED = 'Y')
ORDER BY v.OWNER, v.VIEW_NAME
FETCH FIRST :1 ROWS ONLY
