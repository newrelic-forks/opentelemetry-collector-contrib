/* otel-collector */ SELECT
    SYS_CONTEXT('USERENV', 'DB_NAME') AS DB_NAME,
    SYS_CONTEXT('USERENV', 'CON_NAME') AS PDB_NAME,
    WC.INSTANCE AS INST,
    WC.CHAIN_ID,
    WC.CHAIN_IS_CYCLE,
    WC.SID,
    WC.SESS_SERIAL# AS SERIAL,
    WC.IN_WAIT,
    WC.WAIT_EVENT_TEXT AS WAIT_EVENT,
    WC.WAIT_SECS AS SECONDS_IN_WAIT,
    WC.NUM_WAITERS,
    WC.ROW_WAIT_OBJ# AS LOCKED_OBJECT_ID,
    WC.BLOCKER_INSTANCE AS BLOCKING_INSTANCE,
    WC.BLOCKER_SID AS BLOCKING_SID,
    WC.BLOCKER_SESS_SERIAL# AS BLOCKING_SERIAL,
    WC.BLOCKER_CON_NAME AS BLOCKING_PDB_NAME,
    CASE
        WHEN WC.BLOCKER_SID IS NULL AND WC.NUM_WAITERS > 0 THEN 'YES'
        ELSE 'NO'
    END AS IS_ROOT_BLOCKER,
    CASE
        WHEN WC.BLOCKER_INSTANCE IS NOT NULL AND WC.BLOCKER_INSTANCE != WC.INSTANCE THEN 'CROSS_INSTANCE'
        ELSE 'LOCAL'
    END AS BLOCKING_SCOPE
FROM V$WAIT_CHAINS WC
WHERE WC.INSTANCE = SYS_CONTEXT('USERENV', 'INSTANCE')
  AND (WC.NUM_WAITERS > 0 OR WC.BLOCKER_SID IS NOT NULL)
FETCH FIRST :1 ROWS ONLY
