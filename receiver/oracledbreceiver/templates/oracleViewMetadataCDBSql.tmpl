/* otel-collector */
WITH columns_agg AS (
    SELECT c.CON_ID, c.OWNER, c.TABLE_NAME,
        JSON_ARRAYAGG(
            JSON_OBJECT(
                'name' VALUE c.COLUMN_NAME,
                'data_type' VALUE c.DATA_TYPE,
                'data_length' VALUE c.DATA_LENGTH,
                'nullable' VALUE c.NULLABLE
            ) ORDER BY c.COLUMN_ID
        ) AS COLUMNS_JSON
    FROM CDB_TAB_COLUMNS c
    WHERE c.OWNER NOT IN (SELECT USERNAME FROM CDB_USERS WHERE ORACLE_MAINTAINED = 'Y' AND CON_ID = c.CON_ID)
    GROUP BY c.CON_ID, c.OWNER, c.TABLE_NAME
)
SELECT
    v.OWNER AS SCHEMA_NAME, v.VIEW_NAME,
    NVL(ctr.NAME, '') AS DB_NAMESPACE,
    COALESCE(ca.COLUMNS_JSON, '[]') AS COLUMNS_JSON,
    v.TEXT_VC AS DEFINITION
FROM CDB_VIEWS v
LEFT JOIN V$CONTAINERS ctr ON ctr.CON_ID = v.CON_ID
LEFT JOIN columns_agg ca ON ca.OWNER = v.OWNER AND ca.TABLE_NAME = v.VIEW_NAME AND ca.CON_ID = v.CON_ID
WHERE v.OWNER NOT IN (SELECT USERNAME FROM CDB_USERS WHERE ORACLE_MAINTAINED = 'Y' AND CON_ID = v.CON_ID)
ORDER BY v.OWNER, v.VIEW_NAME
FETCH FIRST :1 ROWS ONLY
