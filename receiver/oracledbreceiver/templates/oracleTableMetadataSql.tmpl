/* otel-collector */
WITH columns_agg AS (
    SELECT c.OWNER, c.TABLE_NAME,
        JSON_ARRAYAGG(
            JSON_OBJECT(
                'name' VALUE c.COLUMN_NAME,
                'data_type' VALUE c.DATA_TYPE,
                'data_length' VALUE c.DATA_LENGTH,
                'nullable' VALUE c.NULLABLE,
                'default' VALUE c.DATA_DEFAULT
            ) ORDER BY c.COLUMN_ID
        ) AS COLUMNS_JSON
    FROM DBA_TAB_COLUMNS c
    WHERE c.OWNER NOT IN (SELECT USERNAME FROM DBA_USERS WHERE ORACLE_MAINTAINED = 'Y')
    GROUP BY c.OWNER, c.TABLE_NAME
),
indexes_agg AS (
    SELECT i.OWNER, i.TABLE_NAME,
        JSON_ARRAYAGG(
            JSON_OBJECT(
                'name' VALUE idx.INDEX_NAME,
                'index_type' VALUE idx.INDEX_TYPE,
                'uniqueness' VALUE idx.UNIQUENESS,
                'column_names' VALUE idx.COLUMN_NAMES
            )
        ) AS INDEXES_JSON
    FROM (
        SELECT ic.TABLE_OWNER AS OWNER, ic.TABLE_NAME, ic.INDEX_NAME,
            MAX(i2.INDEX_TYPE) AS INDEX_TYPE, MAX(i2.UNIQUENESS) AS UNIQUENESS,
            LISTAGG(ic.COLUMN_NAME, ',') WITHIN GROUP (ORDER BY ic.COLUMN_POSITION) AS COLUMN_NAMES
        FROM DBA_IND_COLUMNS ic
        JOIN DBA_INDEXES i2 ON i2.INDEX_NAME = ic.INDEX_NAME AND i2.OWNER = ic.INDEX_OWNER
        WHERE ic.TABLE_OWNER NOT IN (SELECT USERNAME FROM DBA_USERS WHERE ORACLE_MAINTAINED = 'Y')
        GROUP BY ic.TABLE_OWNER, ic.TABLE_NAME, ic.INDEX_NAME
    ) i
    JOIN DBA_INDEXES idx ON idx.INDEX_NAME = i.INDEX_NAME AND idx.OWNER = i.OWNER
    GROUP BY i.OWNER, i.TABLE_NAME
),
foreign_keys_agg AS (
    SELECT fk.OWNER, fk.TABLE_NAME,
        JSON_ARRAYAGG(
            JSON_OBJECT(
                'name' VALUE fk.CONSTRAINT_NAME,
                'column_names' VALUE fk.COLUMN_NAMES,
                'referenced_schema' VALUE fk.R_OWNER,
                'referenced_table_name' VALUE fk.R_TABLE_NAME,
                'referenced_column_names' VALUE fk.R_COLUMN_NAMES,
                'delete_rule' VALUE fk.DELETE_RULE
            )
        ) AS FOREIGN_KEYS_JSON
    FROM (
        SELECT c.OWNER, c.TABLE_NAME, c.CONSTRAINT_NAME, c.DELETE_RULE,
            rc.OWNER AS R_OWNER, rc.TABLE_NAME AS R_TABLE_NAME,
            LISTAGG(cc.COLUMN_NAME, ',') WITHIN GROUP (ORDER BY cc.POSITION) AS COLUMN_NAMES,
            LISTAGG(rcc.COLUMN_NAME, ',') WITHIN GROUP (ORDER BY rcc.POSITION) AS R_COLUMN_NAMES
        FROM DBA_CONSTRAINTS c
        JOIN DBA_CONS_COLUMNS cc ON cc.CONSTRAINT_NAME = c.CONSTRAINT_NAME AND cc.OWNER = c.OWNER
        JOIN DBA_CONSTRAINTS rc ON rc.CONSTRAINT_NAME = c.R_CONSTRAINT_NAME AND rc.OWNER = c.R_OWNER
        JOIN DBA_CONS_COLUMNS rcc ON rcc.CONSTRAINT_NAME = rc.CONSTRAINT_NAME AND rcc.OWNER = rc.OWNER
            AND rcc.POSITION = cc.POSITION
        WHERE c.OWNER NOT IN (SELECT USERNAME FROM DBA_USERS WHERE ORACLE_MAINTAINED = 'Y')
          AND c.CONSTRAINT_TYPE = 'R'
        GROUP BY c.OWNER, c.TABLE_NAME, c.CONSTRAINT_NAME, c.DELETE_RULE, rc.OWNER, rc.TABLE_NAME
    ) fk
    GROUP BY fk.OWNER, fk.TABLE_NAME
),
size_agg AS (
    SELECT TABLE_NAME, OWNER,
        SUM(CASE WHEN KIND = 'TABLE' THEN BYTES ELSE 0 END) AS TABLE_BYTES,
        SUM(CASE WHEN KIND = 'INDEX' THEN BYTES ELSE 0 END) AS INDEX_BYTES,
        SUM(CASE WHEN KIND = 'LOB' THEN BYTES ELSE 0 END) AS LOB_BYTES,
        SUM(BYTES) AS TOTAL_BYTES
    FROM (
        SELECT s.TABLE_NAME, s.OWNER, 'TABLE' AS KIND, seg.BYTES
        FROM DBA_SEGMENTS seg
        JOIN DBA_TABLES s ON s.TABLE_NAME = seg.SEGMENT_NAME AND s.OWNER = seg.OWNER
        WHERE seg.SEGMENT_TYPE IN ('TABLE', 'TABLE PARTITION', 'TABLE SUBPARTITION')
        UNION ALL
        SELECT i.TABLE_NAME, i.OWNER, 'INDEX' AS KIND, seg.BYTES
        FROM DBA_SEGMENTS seg
        JOIN DBA_INDEXES i ON i.INDEX_NAME = seg.SEGMENT_NAME AND i.OWNER = seg.OWNER
        WHERE seg.SEGMENT_TYPE IN ('INDEX', 'INDEX PARTITION', 'INDEX SUBPARTITION')
        UNION ALL
        SELECT l.TABLE_NAME, l.OWNER, 'LOB' AS KIND, seg.BYTES
        FROM DBA_SEGMENTS seg
        JOIN DBA_LOBS l ON l.SEGMENT_NAME = seg.SEGMENT_NAME AND l.OWNER = seg.OWNER
        WHERE seg.SEGMENT_TYPE IN ('LOBSEGMENT', 'LOB PARTITION')
    )
    GROUP BY TABLE_NAME, OWNER
)
SELECT
    t.OWNER AS SCHEMA_NAME, t.TABLE_NAME,
    '' AS DB_NAMESPACE,
    NVL(t.NUM_ROWS, 0) AS ROW_COUNT,
    COALESCE(ca.COLUMNS_JSON, '[]') AS COLUMNS_JSON,
    COALESCE(ia.INDEXES_JSON, '[]') AS INDEXES_JSON,
    COALESCE(fka.FOREIGN_KEYS_JSON, '[]') AS FOREIGN_KEYS_JSON,
    NVL(sa.TABLE_BYTES, 0) AS TABLE_BYTES,
    NVL(sa.INDEX_BYTES, 0) AS INDEX_BYTES,
    NVL(sa.LOB_BYTES, 0) AS LOB_BYTES,
    NVL(sa.TOTAL_BYTES, 0) AS TOTAL_BYTES
FROM DBA_TABLES t
LEFT JOIN columns_agg ca ON ca.OWNER = t.OWNER AND ca.TABLE_NAME = t.TABLE_NAME
LEFT JOIN indexes_agg ia ON ia.OWNER = t.OWNER AND ia.TABLE_NAME = t.TABLE_NAME
LEFT JOIN foreign_keys_agg fka ON fka.OWNER = t.OWNER AND fka.TABLE_NAME = t.TABLE_NAME
LEFT JOIN size_agg sa ON sa.OWNER = t.OWNER AND sa.TABLE_NAME = t.TABLE_NAME
WHERE t.OWNER NOT IN (SELECT USERNAME FROM DBA_USERS WHERE ORACLE_MAINTAINED = 'Y')
  AND t.DROPPED = 'NO'
ORDER BY t.OWNER, t.TABLE_NAME
FETCH FIRST :1 ROWS ONLY
